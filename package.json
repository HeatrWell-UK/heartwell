{
  "name": "heartwell",
  "version": "0.1.0",
  "private": true,
  "description": "Heartwell (heartwellfurniture.co.uk): storefront and admin.",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:leaks": "node scripts/check-sister-leaks.mjs",
    "leaks:fingerprints": "node scripts/build-sister-fingerprints.mjs",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "verify": "npm run check:leaks -- --all && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
