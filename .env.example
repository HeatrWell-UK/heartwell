# Copy to .env.local for local development. Real values live in the hosting
# dashboard (Vercel during the build, Hostinger from launch), never in git.

# development | staging | production. Tracking only ever runs on production.
NEXT_PUBLIC_APP_ENV=development

# The site's own address, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where customers write to us and where emails ask them to reply.
NEXT_PUBLIC_SUPPORT_EMAIL=enquiries@heartwellsofa.co.uk

# Set to true on the live domain at go-live only. Everything else stays noindex.
SITE_INDEXABLE=false

# Supabase. The address and publishable key are public by design (row level
# security guards the data). Local development uses the staging project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key bypasses row level security: server only, never NEXT_PUBLIC.
# Needed from Phase 10 (checkout). Supabase dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# Hostinger SMTP for order emails. Only the password is required; the rest
# default to smtp.hostinger.com:465 and the customer email address.
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# Shown as the sender, e.g. "Heartwell <orders@heartwellsofa.co.uk>" (an alias of SMTP_USER).
MAIL_FROM=
# Shop notifications, and an optional copy.
SHOP_NOTIFY_TO=
SHOP_NOTIFY_COPY=
# Outside production, customer emails go here instead (never to real customers).
EMAIL_TEST_INBOX=

# Address lookup at checkout (optional): homedata | ideal-postcodes | getaddress.
ADDRESS_LOOKUP_PROVIDER=
ADDRESS_LOOKUP_KEY=

# Cloudinary uploads from the admin product editor (optional; photos can be picked or
# pasted without them). Dashboard > Settings > API Keys. The cloud name defaults to Heartwell's.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta Pixel and Conversions API (Phase 14). Until these are set, tracking runs
# as a dry run: every event is built and shown in Admin → Tracking, nothing is
# sent. Real events also need the live domain and NEXT_PUBLIC_APP_ENV=production.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# From Events Manager → Test events. Lets Admin → Tracking's "Test" mode send
# events that appear only in that tab (they never count).
META_TEST_EVENT_CODE=
# Google Analytics 4 (Phase 14): the web stream's Measurement ID, and a
# Measurement Protocol API secret for purchases sent from the server.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=
